# herdr-router secrets. Copy to ~/.config/herdr-router/.env and chmod 600.
# `hroute init` does this for you. Real environment variables take precedence.

# Optional. When set, Jev (typesafe/jev-router on OpenRouter) classifies prompts
# that no regex rule matched, replacing the Haiku classifier.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
